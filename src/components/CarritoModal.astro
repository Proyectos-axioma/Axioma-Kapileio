---
import { Icon } from 'astro-icon/components';
import { SITE_CONTACTO, SITE_TITLE } from '../consts';
---

<!-- Botón del Carrito en el Navbar -->
<button 
    id="btn-abrir-carrito" 
    type="button"
    class="btn btn-ghost btn-circle relative" 
    aria-label="Abrir carrito de compras"
    onclick="document.getElementById('modal-carrito')?.showModal()"
>
    <Icon name="tabler:shopping-cart" class="w-6 h-6 stroke-2" />
    <span 
        id="badge-carrito-count" 
        class="badge badge-primary badge-xs absolute top-1 right-1 font-bold hidden"
    >
        0
    </span>
</button>

<!-- Modal del Carrito -->
<dialog id="modal-carrito" class="modal modal-bottom sm:modal-middle text-left whitespace-normal" data-contacto={SITE_CONTACTO} data-tienda={SITE_TITLE}>
    <div class="modal-box w-11/12 max-w-2xl p-6 relative flex flex-col max-h-[90vh]">
<!-- Botón X para cerrar -->
        <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-4 top-4 z-10">
                <Icon name="tabler:x-filled" class="w-5 h-5" />
            </button>
        </form>

<!-- Cabecera del Modal -->
        <div class="flex items-center gap-3 border-b border-base-300 pb-4 mb-4">
            <Icon name="tabler:shopping-cart" class="w-7 h-7 text-primary stroke-2" />
            <h3 class="text-2xl font-bold">Tu Pedido</h3>
        </div>

<!-- Contenedor con scroll para lista + formulario -->
        <div class="overflow-y-auto flex-1 pr-1 space-y-6">
<!-- Estado Vacío -->
            <div id="carrito-vacio" class="text-center py-12">
                <Icon name="tabler:shopping-cart-off" class="w-16 h-16 mx-auto opacity-30 mb-3" />
                <p class="text-lg font-semibold opacity-60">Tu carrito está vacío</p>
                <p class="text-sm opacity-50 mt-1">Agrega productos del catálogo para armar tu pedido.</p>
            </div>
<!-- Lista de Productos -->
            <div id="carrito-contenido" class="hidden space-y-4">
                <div id="carrito-lista-items" class="space-y-3"></div>

                <!-- Botón para vaciar carrito -->
                <div class="flex justify-end">
                    <button id="btn-vaciar-carrito" type="button" class="btn btn-ghost btn-xs text-error">
                        <Icon name="tabler:trash" class="w-4 h-4" />
                        Vaciar carrito
                    </button>
                </div>
<!-- Resumen de Totales -->
                <div class="bg-base-200 rounded-xl p-4 space-y-2">
                    <div id="fila-ahorro-carrito" class="hidden justify-between text-sm text-success font-semibold">
                        <span>Ahorro por promociones:</span>
                        <span id="carrito-ahorro">-$0.00</span>
                    </div>
                    <div class="flex justify-between items-center text-xl font-extrabold">
                        <span>Total a pagar:</span>
                        <span id="carrito-total" class="text-primary">$0.00</span>
                    </div>
                </div>
                <div class="divider my-2">Datos de entrega</div>
<!-- Formulario de Datos para WhatsApp -->
                <div class="space-y-3">
                    <div>
                        <label class="label py-1">
                            <span class="label-text font-semibold">Tu Nombre *</span>
                        </label>
                        <input 
                            type="text" 
                            id="carrito-nombre" 
                            placeholder="Ej. Juan Pérez" 
                            class="input input-bordered w-full" 
                            required
                        />
                    </div>

                    <div>
                        <label class="label py-1">
                            <span class="label-text font-semibold">Dirección de entrega (o indicar si pasas a recoger)</span>
                        </label>
                        <input 
                            type="text" 
                            id="carrito-direccion" 
                            placeholder="Calle, número, colonia o 'Paso a recoger'" 
                            class="input input-bordered w-full" 
                        />
                    </div>
                    <div>
                        <label class="label py-1">
                            <span class="label-text font-semibold">Notas adicionales</span>
                        </label>
                        <textarea 
                            id="carrito-notas" 
                            rows="2" 
                            placeholder="Ej. Sin cebolla, salsa aparte, referencias del domicilio..." 
                            class="textarea textarea-bordered w-full"
                        ></textarea>
                    </div>
                    <p id="carrito-error-nombre" class="text-error text-sm font-medium hidden">
                        Por favor ingresa tu nombre para continuar con el pedido.
                    </p>
                </div>
            </div>
        </div>
<!-- Pie del Modal / Acciones -->
        <div class="modal-action mt-4 pt-3 border-t border-base-300 flex flex-col-reverse sm:flex-row justify-between gap-2">
            <form method="dialog" class="w-full sm:w-auto">
                <button class="btn btn-outline w-full sm:w-auto">Seguir viendo</button>
            </form>
            <button 
                id="btn-enviar-whatsapp" 
                type="button" 
                class="btn btn-success w-full sm:w-auto gap-2 hidden shadow-lg"
            >
                <Icon name="tabler:brand-whatsapp" class="w-5 h-5" />
                Enviar pedido por WhatsApp
            </button>
        </div>
    </div>
<!-- Cerrar al hacer clic fuera -->
    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>

<script is:inline>
    (function () {
        const STORAGE_KEY = 'axioma_carrito_v1';
        const CLIENTE_KEY = 'axioma_cliente_v1';

        function obtenerCarrito() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                return raw ? JSON.parse(raw) : [];
            } catch (e) {
                return [];
            }
        }

        function guardarCarrito(items) {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
            } catch (e) {}
            renderizarCarrito();
        }

        // Calcula cuánto se cobra realmente según la promoción por cantidad (2x1, 3x2)
        function calcularSubtotalItem(item) {
            const cant = Number(item.cantidad) || 0;
            const precioUnitario = Number(item.precio) || 0;
            const promo = item.promocion || 'ninguna';
            const totalSinPromoCantidad = cant * precioUnitario;

            let unidadesCobradas = cant;
            let avisoPromo = '';

            if (promo === '2x1') {
                unidadesCobradas = Math.floor(cant / 2) + (cant % 2);
                if (cant % 2 === 1) {
                    avisoPromo = '¡Agrega 1 más gratis por promo 2x1!';
                } else if (cant >= 2) {
                    const gratis = Math.floor(cant / 2);
                    avisoPromo = `Promo 2x1 aplicada (${gratis} gratis)`;
                }
            } else if (promo === '3x2') {
                unidadesCobradas = Math.floor(cant / 3) * 2 + (cant % 3);
                if (cant % 3 === 2) {
                    avisoPromo = `¡Agrega 1 más gratis por promo ${promo}!`;
                } else if (cant >= 3) {
                    const gratis = Math.floor(cant / 3);
                    avisoPromo = `Promo ${promo} aplicada (${gratis} gratis)`;
                }
            }

            const subtotal = unidadesCobradas * precioUnitario;
            const ahorro = totalSinPromoCantidad - subtotal;

            return {
                subtotal,
                ahorro,
                unidadesCobradas,
                avisoPromo
            };
        }

        function agregarAlCarrito(producto) {
            const items = obtenerCarrito();
            const index = items.findIndex((i) => i.id === producto.id);
            if (index > -1) {
                items[index].cantidad += 1;
                // Actualizamos precio/promoción por si cambiaron
                items[index].precio = Number(producto.precio);
                items[index].promocion = producto.promocion || 'ninguna';
                items[index].nombre = producto.nombre;
                if (producto.imagen) items[index].imagen = producto.imagen;
            } else {
                items.push({
                    id: producto.id,
                    nombre: producto.nombre,
                    precio: Number(producto.precio),
                    promocion: producto.promocion || 'ninguna',
                    imagen: producto.imagen || '',
                    cantidad: 1
                });
            }
            guardarCarrito(items);
        }

        function cambiarCantidad(id, delta) {
            let items = obtenerCarrito();
            const index = items.findIndex((i) => i.id === id);
            if (index > -1) {
                items[index].cantidad += delta;
                if (items[index].cantidad <= 0) {
                    items.splice(index, 1);
                }
                guardarCarrito(items);
            }
        }

        function eliminarDelCarrito(id) {
            const items = obtenerCarrito().filter((i) => i.id !== id);
            guardarCarrito(items);
        }

        function vaciarCarrito() {
            guardarCarrito([]);
        }

        function renderizarCarrito() {
            const items = obtenerCarrito();
            const badge = document.getElementById('badge-carrito-count');
            const estadoVacio = document.getElementById('carrito-vacio');
            const contenido = document.getElementById('carrito-contenido');
            const lista = document.getElementById('carrito-lista-items');
            const totalEl = document.getElementById('carrito-total');
            const ahorroEl = document.getElementById('carrito-ahorro');
            const filaAhorro = document.getElementById('fila-ahorro-carrito');
            const btnWhatsapp = document.getElementById('btn-enviar-whatsapp');

            const totalUnidades = items.reduce((acc, item) => acc + (Number(item.cantidad) || 0), 0);

            if (badge) {
                badge.textContent = String(totalUnidades);
                if (totalUnidades > 0) {
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }

            if (!lista || !estadoVacio || !contenido || !totalEl || !btnWhatsapp) return;

            if (items.length === 0) {
                estadoVacio.classList.remove('hidden');
                contenido.classList.add('hidden');
                btnWhatsapp.classList.add('hidden');
                lista.innerHTML = '';
                return;
            }

            estadoVacio.classList.add('hidden');
            contenido.classList.remove('hidden');
            btnWhatsapp.classList.remove('hidden');

            let granTotal = 0;
            let granAhorro = 0;

            lista.innerHTML = items.map((item) => {
                const { subtotal, ahorro, avisoPromo } = calcularSubtotalItem(item);
                granTotal += subtotal;
                granAhorro += ahorro;

                const tienePromo = item.promocion && item.promocion !== 'ninguna';
                const badgePromo = tienePromo
                    ? `<span class="badge badge-warning badge-xs font-bold ml-1">${item.promocion}</span>`
                    : '';

                const htmlAviso = avisoPromo
                    ? `<p class="text-xs font-semibold ${ahorro > 0 ? 'text-success' : 'text-warning'} mt-1">${avisoPromo}</p>`
                    : '';

                const precioOriginalTachado = ahorro > 0
                    ? `<span class="text-xs line-through opacity-50 mr-1">$${(item.cantidad * item.precio).toFixed(2)}</span>`
                    : '';

                return `
                    <div class="flex items-center justify-between gap-3 bg-base-200/60 p-3 rounded-xl border border-base-300">
                        <div class="flex items-center gap-3 min-w-0 flex-1">
                            ${item.imagen ? `<img src="${item.imagen}" alt="${item.nombre}" class="w-14 h-14 rounded-lg object-cover flex-shrink-0" />` : ''}
                            <div class="min-w-0 flex-1">
                                <p class="font-bold text-sm sm:text-base truncate flex items-center flex-wrap">
                                    ${item.nombre} ${badgePromo}
                                </p>
                                <p class="text-xs opacity-70">$${Number(item.precio).toFixed(2)} c/u</p>
                                ${htmlAviso}
                            </div>
                        </div>

                        <div class="flex flex-col items-end gap-1">
                            <div class="flex items-center gap-1 bg-base-100 rounded-lg p-1 border border-base-300">
                                <button type="button" data-action="restar" data-id="${item.id}" class="btn btn-ghost btn-xs px-2 font-bold">−</button>
                                <span class="w-6 text-center font-bold text-sm">${item.cantidad}</span>
                                <button type="button" data-action="sumar" data-id="${item.id}" class="btn btn-ghost btn-xs px-2 font-bold">+</button>
                            </div>
                            <div class="text-right">
                                ${precioOriginalTachado}
                                <span class="font-extrabold text-sm sm:text-base">$${subtotal.toFixed(2)}</span>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            totalEl.textContent = `$${granTotal.toFixed(2)}`;
            if (filaAhorro && ahorroEl) {
                if (granAhorro > 0) {
                    filaAhorro.classList.remove('hidden');
                    filaAhorro.classList.add('flex');
                    ahorroEl.textContent = `-$${granAhorro.toFixed(2)}`;
                } else {
                    filaAhorro.classList.add('hidden');
                    filaAhorro.classList.remove('flex');
                }
            }
        }

        function inicializarEventosCarrito() {
            renderizarCarrito();

            // Restaurar datos guardados del cliente si existen
            const inputNombre = document.getElementById('carrito-nombre');
            const inputDireccion = document.getElementById('carrito-direccion');
            const inputNotas = document.getElementById('carrito-notas');

            try {
                const clienteGuardado = JSON.parse(localStorage.getItem(CLIENTE_KEY) || '{}');
                if (inputNombre && clienteGuardado.nombre) inputNombre.value = clienteGuardado.nombre;
                if (inputDireccion && clienteGuardado.direccion) inputDireccion.value = clienteGuardado.direccion;
            } catch (e) {}

            // Delegación de eventos para botones "Agregar al carrito" en toda la página
            document.addEventListener('click', (e) => {
                const btnAdd = e.target.closest('.btn-agregar-carrito');
                if (btnAdd) {
                    e.preventDefault();
                    const producto = {
                        id: btnAdd.getAttribute('data-id'),
                        nombre: btnAdd.getAttribute('data-nombre'),
                        precio: Number(btnAdd.getAttribute('data-precio')),
                        promocion: btnAdd.getAttribute('data-promocion') || 'ninguna',
                        imagen: btnAdd.getAttribute('data-imagen') || ''
                    };
                    agregarAlCarrito(producto);

                    // Feedback visual en el botón
                    const textoOriginal = btnAdd.innerHTML;
                    btnAdd.classList.add('btn-success');
                    btnAdd.innerHTML = '¡Agregado!';
                    setTimeout(() => {
                        btnAdd.classList.remove('btn-success');
                        btnAdd.innerHTML = textoOriginal;
                    }, 900);
                    return;
                }

                // Botones + y - dentro del modal
                const btnAccion = e.target.closest('[data-action]');
                if (btnAccion) {
                    const accion = btnAccion.getAttribute('data-action');
                    const id = btnAccion.getAttribute('data-id');
                    if (accion === 'sumar') cambiarCantidad(id, 1);
                    if (accion === 'restar') cambiarCantidad(id, -1);
                }
            });

            const btnVaciar = document.getElementById('btn-vaciar-carrito');
            if (btnVaciar) {
                btnVaciar.addEventListener('click', () => {
                    vaciarCarrito();
                });
            }

            const btnEnviar = document.getElementById('btn-enviar-whatsapp');
            if (btnEnviar) {
                btnEnviar.addEventListener('click', () => {
                    const items = obtenerCarrito();
                    if (items.length === 0) return;

                    const nombre = inputNombre ? inputNombre.value.trim() : '';
                    const direccion = inputDireccion ? inputDireccion.value.trim() : '';
                    const notas = inputNotas ? inputNotas.value.trim() : '';
                    const errorNombre = document.getElementById('carrito-error-nombre');

                    if (!nombre) {
                        if (errorNombre) errorNombre.classList.remove('hidden');
                        if (inputNombre) inputNombre.focus();
                        return;
                    }
                    if (errorNombre) errorNombre.classList.add('hidden');

                    try {
                        localStorage.setItem(CLIENTE_KEY, JSON.stringify({ nombre, direccion }));
                    } catch (e) {}

                    const dialog = document.getElementById('modal-carrito');
                    const contacto = dialog?.getAttribute('data-contacto') || '';
                    const tienda = dialog?.getAttribute('data-tienda') || '';

                    let totalPedido = 0;
                    let ahorroTotal = 0;

                    const lineasProductos = items.map((item) => {
                        const { subtotal, ahorro } = calcularSubtotalItem(item);
                        totalPedido += subtotal;
                        ahorroTotal += ahorro;
                        const etiquetaPromo = (item.promocion && item.promocion !== 'ninguna') ? ` [Promo ${item.promocion}]` : '';
                        return `• ${item.cantidad}x ${item.nombre}${etiquetaPromo} - $${subtotal.toFixed(2)}`;
                    });

                    let LineasMensaje = [
                        `Hola *${tienda}*, quiero realizar el siguiente pedido:`,
                        '',
                        ...lineasProductos,
                        ''
                    ];

                    if (ahorroTotal > 0) {
                        LineasMensaje.push(`*Ahorro por promociones:* -$${ahorroTotal.toFixed(2)}`);
                    }
                    LineasMensaje.push(`*Total a pagar: $${totalPedido.toFixed(2)}*`);
                    LineasMensaje.push('');
                    LineasMensaje.push(`*Nombre:* ${nombre}`);
                    if (direccion) {
                        LineasMensaje.push(`*Dirección / Entrega:* ${direccion}`);
                    }
                    if (notas) {
                        LineasMensaje.push(`*Notas:* ${notas}`);
                    }

                    const url = `https://wa.me/${contacto}?text=${encodeURIComponent(LineasMensaje.join('\n'))}`;
                    window.open(url, '_blank', 'noopener,noreferrer');
                });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', inicializarEventosCarrito);
        } else {
            inicializarEventosCarrito();
        }
    })();
</script>
